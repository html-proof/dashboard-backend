{
  "info": {
    "name": "Dashboard Backend (Railway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set apiKey to DASHBOARD_API_KEY. Date range: preset=today|yesterday|last_7_days|last_30_days|last_90_days|this_month|last_month|this_year… or start_date/end_date (YYYY-MM-DD)."
  },
  "auth": {
    "type": "bearer",

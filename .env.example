# Server-side only. Never commit .env; never expose these values to any frontend.
PORT=3000
APP_URL=http://localhost:3000          # must be public https:// in production (needed for OAuth + webhooks)
NODE_ENV=development

# Shopify app credentials (Dev Dashboard / Partner app). Used only for OAuth / token exchange.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,read_all_orders,read_customers,read_products,read_inventory,read_locations,read_fulfillments,read_reports

# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=file:data/app.db

# Required in production: bearer key the dashboard must send to /api/*.
DASHBOARD_API_KEY=
SYNC_INTERVAL_SECONDS=10
